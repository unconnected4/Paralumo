# Copy to backend/.env for local development. Never commit .env.
# Every variable the backend reads must be listed here. Spring Boot imports this file
# (spring.config.import=optional:file:.env[.properties]), so bootRun needs no extra setup.
# It is read as a .properties file: put comments on their own lines, never after a value.

# local | test | production
APP_ENV=local
LOG_LEVEL=INFO
PORT=8000

DATABASE_URL=jdbc:postgresql://localhost:5432/paralumo
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/paralumo_test
DATABASE_USER=paralumo
DATABASE_PASSWORD=paralumo

# Signs session JWTs (HMAC-SHA256), so at least 32 characters. Local value only; the production
# value lives in the host's secret store.
AUTH_SECRET=local-dev-only-secret-change-me-0123456789

# fake | yandex
DICTIONARY_PROVIDER=fake
# Required only when DICTIONARY_PROVIDER=yandex
YANDEX_DICT_API_KEY=

# Comma-separated. Leave empty locally (the Vite proxy makes it same-origin).
CORS_ORIGINS=
