{
  // Described in docs/engineering.md ("Debugging"). Start `npm run dev` before "Web: Chrome".
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "OrchestartionApplication",
      "request": "launch",
      "mainClass": "orchestration.OrchestartionApplication",
      "projectName": ""
    },
    {
      "type": "java",
      "name": "OrchestartionApplication",
      "request": "launch",
      "mainClass": "orchestartion.OrchestartionApplication",
      "projectName": ""
    },
    {
      "type": "java",
      "name": "Backend: API",
      "request": "launch",
      "mainClass": "com.paralumo.ParalumoApplication",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "type": "chrome",
      "name": "Web: Chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Backend: API", "Web: Chrome"]
    }
  ]
}
