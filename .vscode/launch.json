{
  // Described in docs/engineering.md ("Debugging"). Start `npm run dev` before "Web: Chrome".
  "version": "0.2.0",
  "configurations": [
    {
      // Runs from backend/ so Spring Boot imports backend/.env (spring.config.import is relative
      // to the working directory). envFile covers the Run/Debug code lens, which may pick this
      // config by main class. No projectName: the Java extension may name the project "backend"
      // or "paralumo-backend", and there is only one main class.
      "type": "java",
      "name": "Backend: API",
      "request": "launch",
      "mainClass": "com.paralumo.ParalumoApplication",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "type": "chrome",
      "name": "Web: Chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Backend: API", "Web: Chrome"]
    }
  ]
}
