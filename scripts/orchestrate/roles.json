{
  "pipeline": {
    "start": "implement",
    "after": {
      "implement": "review",
      "review": "implement"
    }
  },
  "limits": {
    "maxRounds": 8,
    "maxRoundsWithoutCodeChange": 2,
    "roundTimeoutMinutes": 90
  },
  "roles": {
    "implement": {
      "agent": "ClaudeC-Fable",
      "command": "claude",
      "model": "claude-fable-5-1",
      "args": ["-p", "{prompt}", "--model", "{model}", "--dangerously-skip-permissions", "--output-format", "text"],
      "prompt": "scripts/orchestrate/prompts/implement.md"
    },
    "review": {
      "agent": "ClaudeC-Fable",
      "command": "claude",
      "model": "claude-fable-5-1",
      "args": ["-p", "{prompt}", "--model", "{model}", "--dangerously-skip-permissions", "--output-format", "text"],
      "prompt": "scripts/orchestrate/prompts/review.md"
    }
  }
}
