{
  "pipeline": {
    "implementers": ["opus", "gemini", "gpt"],
    "reviewer": "fable"
  },
  "limits": {
    "maxRounds": 30,
    "maxImplementationRoundsPerCycle": 9,
    "roundTimeoutMinutes": 90
  },
  "roles": {
    "opus": {
      "agent": "ClaudeC-Opus5.5",
      "command": "claude",
      "model": "claude-opus-5-5",
      "args": ["-p", "{prompt}", "--model", "{model}", "--dangerously-skip-permissions", "--output-format", "text"],
      "prompt": "scripts/orchestrate/prompts/implement.md"
    },
    "gemini": {
      "agent": "AgyC-Gemini4Argon",
      "command": "agy",
      "model": "gemini-4-argon-high",
      "args": ["-p", "{prompt}", "--model", "{model}", "--dangerously-skip-permissions", "--output-format", "text"],
      "prompt": "scripts/orchestrate/prompts/implement.md"
    },
    "gpt": {
      "agent": "CodexC-GPT5.6Terra",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "args": ["exec", "--model", "{model}", "--dangerously-bypass-approvals-and-sandbox", "{prompt}"],
      "prompt": "scripts/orchestrate/prompts/implement.md"
    },
    "fable": {
      "agent": "ClaudeC-Fable",
      "command": "claude",
      "model": "claude-fable-5-1",
      "args": ["-p", "{prompt}", "--model", "{model}", "--dangerously-skip-permissions", "--output-format", "text"],
      "prompt": "scripts/orchestrate/prompts/review.md"
    }
  }
}
