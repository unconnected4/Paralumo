# Copy to web/.env.local if you need to override defaults. Never commit real .env files.
# VITE_* values are bundled into the public JS. Never put secrets here.

# Where the Vite dev server proxies /api (dev only, not bundled)
API_PROXY_TARGET=http://localhost:8000

# Origin the browser sends API calls to (request paths already start with /api). Empty = same origin.
VITE_API_BASE_URL=
